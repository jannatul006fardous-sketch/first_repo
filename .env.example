APP_NAME="REFA"
APP_URL="http://localhost/REFA"
APP_ENV=local
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=refa
DB_USER=root
DB_PASS=

MAIL_DRIVER=log
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_FROM=noreply@refa.org
SMTP_FROM_NAME="রেমিট্যান্স ফাইটার্স অ্যাসোসিয়েশন"
ADMIN_NOTIFY_EMAIL=admin@refa.org

UPLOAD_MAX_MB=2
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
